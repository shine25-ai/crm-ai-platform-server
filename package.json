{
  "name": "crm-ai-platform-server",
  "version": "1.0.0",
  "description": "crm-ai-platform-server",
  "main": "index.js",
  "scripts": {
    "start": "nodemon src/server.js",
    "dev": "NODE_ENV=development nodemon src/server.js",
    "test": "NODE_ENV=testing nodemon src/server.js",
    "staging": "NODE_ENV=staging node dist-server/server.js",
    "prod": "NODE_ENV=production node dist-server/server.js",
    "build": "esbuild src/server.js --bundle --platform=node --target=node24 --outfile=dist-server/server.js --packages=external --loader:.jpg=dataurl --loader:.png=dataurl --sourcemap",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shine25-ai/crm-ai-platform-server.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/shine25-ai/crm-ai-platform-server/issues"
  },
  "homepage": "https://github.com/shine25-ai/crm-ai-platform-server#readme",
  "dependencies": {
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "mongoose": "^9.6.3",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3"
  },
  "lint-staged": {
    "src/**/*.js": [
      "prettier --write"
    ]
  }
}
